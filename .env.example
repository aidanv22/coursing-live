# --- Toll-Free Verification (ISV/Reseller) ---
# See TELNYX_ISV_RESELLER_NAME further down for the Telnyx equivalent of
# this. Telnyx doesn't require a separate approved "Primary Customer
# Profile" the way Twilio did — TFV requests are submitted per-number
# directly, with the isvReseller field doing the equivalent work.

# --- Admin notifications ---
# Your personal email — you'll get notified here whenever someone joins the
# waitlist or creates a new company account. Leave blank to disable.
ADMIN_NOTIFY_EMAIL=

# --- Platform admin ---
# The email of YOUR OWN Coursing company account (the one you sign up with
# as yourself, not a hardscaping business). Whichever account has this email
# automatically gets an "Admin" link in its dashboard nav, showing every
# company on the platform and their usage. Set this to your own login email.
PLATFORM_ADMIN_EMAIL=

# --- App URL ---
# Your production URL, no trailing slash. Used to build unsubscribe links in
# emails (e.g. https://coursingonline.com or https://coursing-live.vercel.app
# until your custom domain is fully live).
APP_URL=

# --- Database (already set up via Neon on Vercel Marketplace) ---
# Vercel injects this automatically once you've connected the Neon integration.
DATABASE_URL=

# --- Auth ---
# Any long random string. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# --- AI content generation ---
ANTHROPIC_API_KEY=

# --- Email sending (https://resend.com) ---
RESEND_API_KEY=
# Optional — defaults to onboarding@resend.dev (Resend's shared testing domain,
# fine to start with). Once you verify your own domain in Resend, set this
# per-company instead via Dashboard > Settings.
RESEND_FROM_EMAIL=

# --- SMS sending (https://telnyx.com) ---
TELNYX_API_KEY=
# The Messaging Profile ID your toll-free numbers are assigned to (Portal >
# Messaging > Messaging Profiles). Required for both outbound sends and
# inbound webhook replies.
TELNYX_MESSAGING_PROFILE_ID=
# Your account's Ed25519 public key (Portal > Account Settings > Keys &
# Credentials > Public Key sub-tab), base64-encoded. Used to verify that
# inbound webhooks to /api/sms/inbound actually came from Telnyx.
TELNYX_PUBLIC_KEY=
# Optional. Your business/reseller name, used as the default `isvReseller`
# field when submitting a Toll-Free Verification request on behalf of a
# client business whose domain differs from your Telnyx account's domain —
# e.g. "Coursing". Leave blank if you're only ever registering numbers for
# your own direct use.
TELNYX_ISV_RESELLER_NAME=
# Per-company Telnyx toll-free numbers are no longer stored in an env var —
# each company now has its own dedicated number, assigned in
# /dashboard/admin (each business needs its own Toll-Free Verification; a
# single shared number doesn't satisfy carrier verification).

# --- Cron protection ---
# Optional but recommended. Set this, then add the same value as a Vercel
# "Cron Secret" (Project Settings > Environment Variables) so only Vercel's
# scheduler can trigger /api/cron/weekly and /api/cron/monthly.
CRON_SECRET=

# --- Existing admin waitlist page ---
ADMIN_PASSWORD=
