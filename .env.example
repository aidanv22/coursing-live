# --- ISV / Toll-Free Verification ---
# Your approved Primary Customer Profile SID (starts with BU...) from Trust
# Hub, once Twilio approves you as "ISV Reseller or Partner." Used as the
# default when submitting new Toll-Free Verification requests from
# /dashboard/admin/toll-free — leave blank until you have this.
TWILIO_ISV_CUSTOMER_PROFILE_SID=

# --- Admin notifications ---
# Your personal email — you'll get notified here whenever someone joins the
# waitlist or creates a new company account. Leave blank to disable.
ADMIN_NOTIFY_EMAIL=

# --- Platform admin ---
# The email of YOUR OWN Coursing company account (the one you sign up with
# as yourself, not a hardscaping business). Whichever account has this email
# automatically gets an "Admin" link in its dashboard nav, showing every
# company on the platform and their usage. Set this to your own login email.
PLATFORM_ADMIN_EMAIL=

# --- App URL ---
# Your production URL, no trailing slash. Used to build unsubscribe links in
# emails (e.g. https://coursingonline.com or https://coursing-live.vercel.app
# until your custom domain is fully live).
APP_URL=

# --- Database (already set up via Neon on Vercel Marketplace) ---
# Vercel injects this automatically once you've connected the Neon integration.
DATABASE_URL=

# --- Auth ---
# Any long random string. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# --- AI content generation ---
ANTHROPIC_API_KEY=

# --- Email sending (https://resend.com) ---
RESEND_API_KEY=
# Optional — defaults to onboarding@resend.dev (Resend's shared testing domain,
# fine to start with). Once you verify your own domain in Resend, set this
# per-company instead via Dashboard > Settings.
RESEND_FROM_EMAIL=

# --- SMS sending (https://twilio.com) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER is no longer used for sending — each company now has
# its own dedicated number, assigned in /dashboard/admin under the ISV
# architecture (each business needs its own verified Toll-Free/10DLC
# number; a single shared number doesn't satisfy carrier verification).
# Kept here only as a historical note, safe to remove.
TWILIO_FROM_NUMBER=

# --- Cron protection ---
# Optional but recommended. Set this, then add the same value as a Vercel
# "Cron Secret" (Project Settings > Environment Variables) so only Vercel's
# scheduler can trigger /api/cron/weekly and /api/cron/monthly.
CRON_SECRET=

# --- Existing admin waitlist page ---
ADMIN_PASSWORD=
